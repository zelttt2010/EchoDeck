{
  "version": 6,
  "cmakeMinimumRequired": { "major": 3, "minor": 25, "patch": 0 },
  "configurePresets": [
    {
      "name": "windows-msvc-x64",
      "displayName": "Windows MSVC x64",
      "generator": "Visual Studio 17 2022",
      "architecture": "x64",
      "binaryDir": "${sourceDir}/build/msvc-x64",
      "cacheVariables": {
        "CMAKE_CXX_STANDARD": "20",
        "CMAKE_CONFIGURATION_TYPES": "Debug;Release"
      }
    }
  ],
  "buildPresets": [
    { "name": "windows-release", "configurePreset": "windows-msvc-x64", "configuration": "Release" },
    { "name": "windows-debug", "configurePreset": "windows-msvc-x64", "configuration": "Debug" }
  ],
  "testPresets": [
    { "name": "windows-release-tests", "configurePreset": "windows-msvc-x64", "configuration": "Release", "output": { "outputOnFailure": true } }
  ]
}
